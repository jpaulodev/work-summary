# work-summary — copy this file to `.env` and fill it in.
#   cp .env.example .env
# The API and CLI auto-load `.env` from the directory you run them in (the repo
# root). `.env` is gitignored; this `.env.example` is committed as the template.

# ─── Web dashboard + API (Option B) ──────────────────────────────────────────

# REQUIRED. Derives the AES-256-GCM master key and the session secret. Use a
# long random value and keep it stable — it decrypts your stored secrets.
MASTER_PASSPHRASE=change-me-to-a-long-random-string

# Ports. Change these to whatever you like.
PORT=3001          # the API (and, in production, the served dashboard)
WEB_PORT=5173      # the Vite dev server (dev mode only); proxies /api -> PORT

# Bind address. Default 127.0.0.1 = this machine only. Set 0.0.0.0 to reach the
# dashboard from OTHER machines on your network.
# HOST=0.0.0.0

# Base URL used to build the OAuth redirect URIs AND to decide cookie security.
# MUST match what you register in the OAuth apps below and the URL you open in
# the browser. Use the SAME host you actually browse to:
#   - this machine, one origin:  http://localhost:3001
#   - dev mode (Vite + API):     http://localhost:5173
#   - another machine (LAN):     http://<this-machine-ip>:3001   (with HOST=0.0.0.0)
# Session cookies are marked Secure only when this is https:// — over plain http
# (a LAN IP) a Secure cookie would be dropped by the browser and you'd get
# "unauthenticated". Put https here only if you actually terminate TLS.
PUBLIC_BASE_URL=http://localhost:3001

# Override cookie Secure flag if needed (e.g. behind a TLS-terminating proxy
# where PUBLIC_BASE_URL is https but the app speaks http). true | false.
# COOKIE_SECURE=

# GitHub OAuth App — github.com → Settings → Developer settings → OAuth Apps.
# Authorization callback URL: ${PUBLIC_BASE_URL}/api/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# JIRA / Atlassian OAuth 2.0 (3LO) — developer.atlassian.com/console.
# Callback URL: ${PUBLIC_BASE_URL}/api/oauth/jira/callback. Optional (skip if
# you don't connect JIRA).
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=

# Serve the built dashboard from the API origin (one port). Set when running
# `node apps/api/dist/bin.js` as your single process.
# NODE_ENV=production

# Optional: override the SQLite state dir (default ~/.local/state).
# XDG_STATE_HOME=

# ─── CLI (Option A: cron, email only) ────────────────────────────────────────
# GITHUB_TOKEN=ghp_xxxx          # repo + read:user scopes
# SMTP_USER=me@example.com
# SMTP_PASS=app-password
